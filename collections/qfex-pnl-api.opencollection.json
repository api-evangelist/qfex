{
  "opencollection": "1.0.0",
  "info": {
    "name": "QFEX REST market-data pnl API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "pnl",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Hourly PnL (approx. first position per hour)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.qfex.com/pnl",
            "params": [
              {
                "name": "symbol",
                "value": "",
                "type": "query"
              },
              {
                "name": "start",
                "value": "",
                "type": "query"
              },
              {
                "name": "end",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit_hours",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-qfex-hmac-signature",
              "value": "{{x-qfex-hmac-signature}}",
              "placement": "header"
            }
          },
          "docs": "Return approximate first position per symbol per hour for the user, including realised/unrealised pnl, net_funding, fees, quantity, and cost."
        }
      ]
    }
  ],
  "bundled": true
}