          "info": {
            "name": "Stream Historic Orders CSV",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.qfex.com/historic-orders-csv",
            "auth": {
              "type": "apikey",
              "key": "x-qfex-hmac-signature",
              "value": "{{x-qfex-hmac-signature}}",
              "placement": "header"
            }
          },
          "docs": "Stream a CSV of all historic orders for the authenticated user."
        },
        {
          "info": {
            "name": "Stream Historic TWAPs CSV",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.qfex.com/historic-twaps-csv",
            "params": [
              {
                "name": "symbol",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-qfex-hmac-signature",
              "value": "{{x-qfex-hmac-signature}}",
              "placement": "header"
            }
